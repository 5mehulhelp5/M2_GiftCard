<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Market\GiftCard\Api\Data\GiftCardInterface" type="Market\GiftCard\Model\GiftCard" />
    <preference for="Market\GiftCard\Api\Data\GiftCardUsageInterface" type="Market\GiftCard\Model\GiftCardUsage" />
    <preference for="Market\GiftCard\Api\Data\GiftCardQuoteInterface" type="Market\GiftCard\Model\GiftCardQuote" />

    <preference for="Market\GiftCard\Api\GiftCardRepositoryInterface" type="Market\GiftCard\Model\GiftCardRepository" />
    <preference for="Market\GiftCard\Api\GiftCardUsageRepositoryInterface" type="Market\GiftCard\Model\GiftCardUsageRepository" />
    <preference for="Market\GiftCard\Api\Data\GiftCardSearchResultsInterface" type="Market\GiftCard\Model\GiftCardSearchResults" />
    <preference for="Market\GiftCard\Api\Data\GiftCardUsageSearchResultsInterface" type="Market\GiftCard\Model\GiftCardUsageSearchResults" />
    <preference for="Market\GiftCard\Api\GiftCardRetrieverInterface" type="Market\GiftCard\Model\GiftCardRetriever" />


    <virtualType name="Market\GiftCard\Model\ResourceModel\Product\Indexer\Price\GiftCardProductPrice"
                 type="Magento\Catalog\Model\ResourceModel\Product\Indexer\Price\SimpleProductPrice">
        <arguments>
            <argument name="productType" xsi:type="const">Market\GiftCard\Model\Type\GiftCard::TYPE_CODE</argument>
        </arguments>
    </virtualType>


    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="market_giftcard_listing_data_source" xsi:type="string">Market\GiftCard\Model\ResourceModel\GiftCard\Grid\Collection</item>
            </argument>
        </arguments>
    </type>

    <type name="Market\GiftCard\Model\ResourceModel\GiftCard\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">market_gift_card</argument>
            <argument name="eventPrefix" xsi:type="string">market_giftcard_grid_collection</argument>
            <argument name="eventObject" xsi:type="string">market_giftcard_grid_collection</argument>
            <argument name="resourceModel" xsi:type="string">Market\GiftCard\Model\ResourceModel\GiftCard</argument>
        </arguments>
    </type>

    <type name="Magento\InventorySales\Model\IsProductSalableForRequestedQtyCondition\IsProductSalableForRequestedQtyConditionChain" >
        <plugin name="PreventInventoryForGiftCard" type="Market\GiftCard\Plugin\PreventInventoryForGiftCard" />
    </type>

    <type name="Magento\Quote\Model\Quote\Item\ToOrderItem" >
        <plugin name="PreventInventoryForGiftCard" type="Market\GiftCard\Plugin\MoveQuoteItemOptionsToOrderItem" />
    </type>

    <type name="Magento\CatalogInventory\Model\Quote\Item\QuantityValidator" >
        <plugin name="PreventQtyLookupForGiftCard" type="Market\GiftCard\Plugin\PreventQtyLookupForGiftCard" />
    </type>

    <type name="Magento\Quote\Model\QuoteFactory" >
        <plugin name="EnsureQuoteExtensionAttributes" type="Market\GiftCard\Plugin\EnsureQuoteExtensionAttributes" />
    </type>

    <type name="Magento\Quote\Api\CartRepositoryInterface" >
        <plugin name="AssignGiftCardIdToQuote" type="Market\GiftCard\Plugin\AssignGiftCardIdToQuote" />
    </type>
</config>
