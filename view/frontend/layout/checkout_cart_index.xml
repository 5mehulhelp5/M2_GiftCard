<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout.cart.form">
            <arguments>
                <argument name="overridden_templates" xsi:type="array">
                    <item name="giftcard" xsi:type="string">Market_GiftCard::cart/item/giftcard.phtml</item>
                </argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="checkout.cart.item.renderers.default">
            <arguments>
                <argument name="cart_item_detail" xsi:type="object">Market\GiftCard\ViewModel\CartDetails</argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
